# 実会場のブース・テーブル定義(46 オブジェクト)。
#
# - kind: booth(体験ブース)/ kitchen_car(キッチンカー)/ table(テーブル・椅子)
#   table は方向・専用出入口を持たず、周囲4辺から着席する。
#   capacity は同時着席可能人数。
# - theme: normal で通常色。normal 以外は自由文字列(意味の分かるラベルにする)で、
#   可視化側(src/visualization.py の booth_style_map)が登場順に自動で色を
#   割り当てラベルとしてそのまま表示する。コード側の色定義追加は不要。
# - area: 所属広場(venue_shape.areas の name)。本体セルがこの広場内に
#   収まることが配置制約になる。
# - width/height: width が正面(長辺)、height が奥行き。受付・退出は常に
#   width 辺(南辺)に配置されるため、実寸(2×3, 3×7)に対して縦横を入れ替えて
#   定義している(例: 実寸 2×3 のブースは width: 3, height: 2)。
# - fixed_position: 通常ブースは [x,y,theta]、方向を持たないテーブルは [x,y]。
#   theta は 0=北, 1=東, 2=南, 3=西(src/venue.py の THETA_*)。受付・退出は
#   通常ブースでは theta の指す辺(正面)に配置されるため、theta は「ブースの向き」を
#   そのまま表す。全ブース南向き(2)で正面が南辺(=長辺)を向く。
#   scripts/run_fixed_layout.py がこの座標で人流シミュレーションを行う。
#   最適化(run_optimization.py)ではこの値は使わず座標・向きを変数として扱う。
# - attractiveness / capacity / mean_service_seconds / max_queue_length は
#   暫定値(ブース条件は後で詰める)。
#
# 待機列は L 字形(左辺→上辺→右辺、南辺は空けておく)。実寸 2x3 ブースの
# 待機列は最大 5 セル、実寸 3x7 ブースは最大 8 セルに設定。
booths:
  # ================= 上部広場: ブース 12 個(実寸2×3) + 大型 1 個(実寸3×7) =================
  - {booth_id: 0,  name: 上部ブース1,  width: 3, height: 2, category: goods,   attractiveness: 0.7, capacity: 2, mean_service_seconds: 30, max_queue_length: 5, kind: booth, theme: normal, area: upper_plaza, fixed_position: [17, 11, 1]}
  - {booth_id: 1,  name: 上部ブース2,  width: 3, height: 2, category: goods,   attractiveness: 0.7, capacity: 2, mean_service_seconds: 30, max_queue_length: 5, kind: booth, theme: normal, area: upper_plaza, fixed_position: [17, 25, 1]}
  - {booth_id: 2,  name: 上部ブース3,  width: 3, height: 2, category: goods,   attractiveness: 0.7, capacity: 2, mean_service_seconds: 30, max_queue_length: 5, kind: booth, theme: normal, area: upper_plaza, fixed_position: [26, 11, 2]}
  - {booth_id: 3,  name: 上部ブース4,  width: 3, height: 2, category: goods,   attractiveness: 0.7, capacity: 2, mean_service_seconds: 30, max_queue_length: 5, kind: booth, theme: normal, area: upper_plaza, fixed_position: [30, 11, 2]}
  - {booth_id: 4,  name: 上部ブース5,  width: 3, height: 2, category: workshop, attractiveness: 0.7, capacity: 2, mean_service_seconds: 30, max_queue_length: 5, kind: booth, theme: normal, area: upper_plaza, fixed_position: [17, 15, 1]}
  - {booth_id: 5,  name: 上部ブース6,  width: 3, height: 2, category: workshop, attractiveness: 0.7, capacity: 2, mean_service_seconds: 30, max_queue_length: 5, kind: booth, theme: normal, area: upper_plaza, fixed_position: [17, 29, 1]}
  - {booth_id: 6,  name: 上部ブース7,  width: 3, height: 2, category: workshop, attractiveness: 0.7, capacity: 2, mean_service_seconds: 30, max_queue_length: 5, kind: booth, theme: normal, area: upper_plaza, fixed_position: [35, 14, 2]}
  - {booth_id: 7,  name: 上部ブース8,  width: 3, height: 2, category: workshop, attractiveness: 0.7, capacity: 2, mean_service_seconds: 30, max_queue_length: 5, kind: booth, theme: normal, area: upper_plaza, fixed_position: [39, 17, 2]}
  - {booth_id: 8,  name: 上部ブース9,  width: 3, height: 2, category: goods,   attractiveness: 0.7, capacity: 2, mean_service_seconds: 30, max_queue_length: 5, kind: booth, theme: normal, area: upper_plaza, fixed_position: [17, 19, 1]}
